<Project>

  <PropertyGroup>
    <Configuration>Release</Configuration>
    <WebPublishMethod>MSDeploy</WebPublishMethod>
    <PublishProvider>MSDeploy</PublishProvider>
    <!-- آدرس سرور IIS خود را جایگزین کنید -->
    <MSDeployServiceURL>localhost</MSDeployServiceURL>
    <DeployIisAppPath>World of Games</DeployIisAppPath>
    <DeployDefaultTarget>WebServer</DeployDefaultTarget>
    <MSDeployUseAgent>true</MSDeployUseAgent>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <SiteUrlToLaunchAfterPublish />
    <LaunchSiteAfterPublish>false</LaunchSiteAfterPublish>
    <ExcludeApp_Data>false</ExcludeApp_Data>
    <PublishDatabaseSettings />
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

</Project>
